# ==============================================================================
# RoL d20 - Docker Environment Configuration
# ==============================================================================

# Web application port on the host (Default: 8090 to prevent collision with QNAP QTS 8080)
WEB_PORT=8090

# phpMyAdmin management port on the host (Default: 8885 to prevent collision with QNAP system apps)
PMA_PORT=8885

# MySQL port exposed to the host (Default: 3307 to avoid collision with QNAP native MySQL 3306)
DB_PORT=3307

# Database Credentials
DB_NAME=rold20
DB_USER=rold20_user
DB_PASSWORD=rold20_secure_pass
DB_ROOT_PASSWORD=rold20_root_secure_pass
